---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ArticlePost from '../../layouts/ArticlePost.astro';
import NoteFeedback from '../../components/NoteFeedback.astro';

export async function getStaticPaths() {
	const entries = await getCollection('learningLog');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'learningLog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const reportTypeLabels: Record<string, string> = {
	'daily':    'Daily',
	'weekly':   'Weekly',
	'monthly':  'Monthly',
	'meta':     'Meta',
	'notebook': 'Daily', // 목록 페이지 통계·칩과 통일 (notebook = daily 트랙의 후신)
};

const categoryLabel = reportTypeLabels[entry.data.reportType] || entry.data.reportType;
---

<ArticlePost
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	category={categoryLabel}
	tags={entry.data.tags}
	slug={`learning-log/${entry.id}`}
	lang="ko"
>
	{entry.id !== 'welcome' && (
		<p class="auto-notice">자동 생성 · 사람 미검수. 지교수가 사람의 검수 없이 쓴 기록이다.</p>
	)}
	<Content />
	<NoteFeedback slug={`learning-log/${entry.id}`} />
</ArticlePost>

<style>
	.auto-notice {
		font-size: 0.82em;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0 0 1.6em;
		padding: 0.55em 0.9em;
		border-left: 2px solid var(--accent);
		background: rgba(184,160,122,0.06);
	}
</style>
